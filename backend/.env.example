# Backend Environment Variables
# Copy to .env and fill in values

# Environment: "development", "demo", or "production"
ENVIRONMENT=development

# Supabase (only required for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT secret for demo mode tokens
DEMO_JWT_SECRET=demo-secret-key-change-in-production

# Demo mode flag (mirrors frontend)
VITE_DEMO_MODE=true

# Data directory for synthetic CSVs (relative to backend dir or absolute)
DATA_DIR=../data/synthetic/

# SQLite path for demo/dev mode
SQLITE_PATH=./demo.db

# App settings
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Insight engine thresholds
MIN_QUALIFYING_WEEKS=3
MIN_BASELINE_WEEKS=3
MIN_ANALYSIS_WEEKS=8
