# Backend Environment Variables
# Copy to .env and fill in values

# Environment: "development", "demo", or "production"
ENVIRONMENT=development

# LOCAL MODE: Supabase is NOT required. Leave all Supabase values unset.
# The backend uses SQLite at SQLITE_PATH when ENVIRONMENT is development/demo/test.
# Only configure Supabase credentials if you deliberately deploy in production.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Optional: only for legacy Supabase projects using HS256 JWT signing.
# Never put the public anon key here.
# SUPABASE_JWT_SECRET=

# Demo mode uses local demo personas; this is not production authentication.
# Replace with a random secret for any shared non-production environment.
DEMO_JWT_SECRET=local-demo-only-change-me-please-32-chars

# Demo mode flag (mirrors frontend)
VITE_DEMO_MODE=true

# Data directory for synthetic CSVs (relative to backend dir or absolute)
DATA_DIR=../data/synthetic/

# SQLite path for demo/dev mode
SQLITE_PATH=./demo.db

# App settings
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Insight engine thresholds
MIN_QUALIFYING_WEEKS=3
MIN_BASELINE_WEEKS=3
MIN_ANALYSIS_WEEKS=8
