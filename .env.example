# ============================================================
# Life, Decoded — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Supabase (required for production) -------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Backend only

# ----- Backend config ---------------------------------------
SECRET_KEY=change-this-to-a-random-32-char-string
ENVIRONMENT=development          # development | production
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
PORT=8000

# ----- Frontend (Vite prefix required) ----------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_DEMO_MODE=true              # true enables local demo auth
VITE_APP_ENV=development

# ----- Sentry (optional, add keys to enable) ----------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ----- PostHog (optional, add key to enable) ----------------
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

